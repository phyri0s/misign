# Qt Test conventions: private slots are instance methods, data functions end
# in "_data", and QFETCH declares non-const variables.
InheritParentConfig: true
Checks: >
  -readability-convert-member-functions-to-static,
  -misc-const-correctness
CheckOptions:
  readability-identifier-naming.MethodIgnoredRegexp: "^[a-z][a-zA-Z0-9]*_data$"
